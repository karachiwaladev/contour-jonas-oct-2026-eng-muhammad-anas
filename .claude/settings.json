{
  "permissions": {
    "allow": [
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-prompts.sh 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true
  }
}
